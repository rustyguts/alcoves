{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "bun run typecheck",
		"lint": "prettier --check . && eslint .",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"coverage:floor": "node scripts/coverage-floor.mjs",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:screenshots": "playwright test --project=desktop-light --project=desktop-dark --project=mobile-light --project=mobile-dark",
		"test:e2e:screenshots:update": "playwright test --update-snapshots --project=desktop-light --project=desktop-dark --project=mobile-light --project=mobile-dark",
		"test": "vitest run && playwright test --project=chromium"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/lineicons": "^1.2.6",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/leaflet": "^1.9.21",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.1",
		"@skeletonlabs/skeleton": "^4.15.2",
		"@skeletonlabs/skeleton-svelte": "^4.15.2",
		"@sveltejs/kit": "^2.57.0",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"svelte": "^5.55.2",
		"tus-js-client": "^4.3.1",
		"vidstack": "1.12.13",
		"zod": "^4.4.3"
	}
}
