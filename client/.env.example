# ── Alcoves client (SvelteKit) environment ───────────────────────────────────
# Copy to `.env` for local dev. PUBLIC_* vars are exposed to the browser via
# `$env/static/public`; everything else is server-only (`$env/dynamic/private`).

# Go API base used by the SvelteKit server: server-side `load` calls and the
# /api/[...path] proxy target. In docker-compose this is http://backend:3001.
INTERNAL_API_URL=http://localhost:3001

# Public API origin for the browser to stream binaries (video, image proxy, tus)
# DIRECTLY to the Go API, bypassing the SvelteKit /api proxy (avoids Range
# mangling). Leave empty to route everything same-origin through the proxy.
PUBLIC_API_ORIGIN=

# ── adapter-node runtime (production `node build` / `bun build`) ──────────────
# Prefixed FRONTEND_ (svelte.config.js envPrefix) so they don't collide with the
# Go API's PORT in the unified single-image `all` role.
# FRONTEND_ORIGIN is REQUIRED by adapter-node for POST/cookie origin checks.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
# Must be large/unbounded or TUS chunk PATCH bodies streamed through the proxy
# are rejected. Use "Infinity" to disable the limit.
FRONTEND_BODY_SIZE_LIMIT=Infinity

# ── Public feature flags / config (browser-visible) ──────────────────────────
PUBLIC_GOOGLE_AUTH_ENABLED=false
PUBLIC_SENTRY_DSN=
PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
