---
const features = [
	{
		size: 'lg',
		title: 'One place for everything',
		text: 'Keep your photos, video, audio, and documents together. Upload from your browser, organize into folders, and find things later.',
		icon: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
	},
	{
		size: 'lg',
		title: 'Made to share',
		text: 'Group your files into libraries and invite the people you want — each with the access that fits, from full control to view-only. Sharing is always deliberate.',
		icon: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15 20a5.5 5.5 0 0 1 6.5-5.4"/>',
	},
	{
		size: 'sm',
		title: 'Understands your media',
		text: 'Alcoves looks at what is in your photos and videos, so you can find things by their contents — not just their file names.',
		icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4-4L5 21"/>',
	},
	{
		size: 'sm',
		title: 'Open to your tools',
		text: 'A built-in MCP server lets you connect Alcoves to AI assistants and build your own workflows around your library.',
		icon: '<path d="M12 2v6M12 16v6M2 12h6M16 12h6"/><circle cx="12" cy="12" r="4"/>',
	},
	{
		size: 'sm',
		title: 'Runs on your hardware',
		text: 'Self-host on whatever you have — from a small home server to a larger setup — using storage you control.',
		icon: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 8h.01M7 17h.01"/>',
	},
];
---

<section class="section" id="features">
	<div class="container">
		<div class="section-head reveal">
			<p class="kicker">What it does</p>
			<h2 class="section-title">One place for your files and media</h2>
			<p class="section-lead">
				Keep your files together, make sense of what is inside them, and share them
				with the people you choose.
			</p>
		</div>

		<div class="bento">
			{
				features.map((f, i) => (
					<article
						class:list={['bento-card', 'reveal', { lg: f.size === 'lg' }]}
						style={`--d:${(i % 3) * 70}ms`}
					>
						<span class="feat-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={f.icon}
							/>
						</span>
						<h3 class="feat-title">{f.title}</h3>
						<p class="feat-text">{f.text}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
