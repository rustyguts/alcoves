---
const REPO = 'https://github.com/rustyguts/alcoves';
---

<section class="final">
	<div class="container">
		<div class="final-card reveal">
			<h2 class="final-title">Self-host Alcoves in minutes</h2>
			<p class="final-sub">
				Take back ownership of your media. Spin up the full stack with Docker
				Compose, register the first account, and start uploading — your library,
				your hardware, your rules.
			</p>
			<div class="final-cta">
				<a class="btn btn-primary btn-lg" href="/getting-started/quickstart/">
					Deploy with Docker
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
				<a class="btn btn-ghost btn-lg" href={REPO} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.6 5.62.6 11.9c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.36-3.84-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.53-.29-5.2-1.27-5.2-5.64 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 5.74 0c2.18-1.48 3.14-1.17 3.14-1.17.63 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.38-2.67 5.35-5.21 5.63.41.36.78 1.07.78 2.16v3.2c0 .31.2.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.4 5.62 18.27.5 12 .5Z"></path></svg>
					Star on GitHub
				</a>
			</div>
		</div>
	</div>
</section>
