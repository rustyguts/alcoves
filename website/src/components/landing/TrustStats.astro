---
const stats = [
	{ num: 'Self-hosted', label: 'Runs on hardware you control.' },
	{ num: 'Collaborative', label: 'Share libraries with the people you choose.' },
	{ num: 'Organized', label: 'Browse and search by what is in your files.' },
	{ num: 'Open', label: 'Connect it to your own tools and workflows.' },
];
---

<section class="band">
	<div class="container">
		<div class="band-grid reveal">
			{
				stats.map((s) => (
					<div class="band-item">
						<div class="band-num">{s.num}</div>
						<div class="band-label">{s.label}</div>
					</div>
				))
			}
		</div>
	</div>
</section>
