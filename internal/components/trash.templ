package components

import "github.com/rustyguts/alcoves/internal/models"

type TrashViewData struct {
	Assets []models.Asset
}

templ Trash(data TrashViewData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Trash - Alcoves</title>
			<link rel="stylesheet" href="/static/main.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<div class="drawer">
				<input id="drawer-sidebar-toggle" type="checkbox" class="drawer-toggle"/>
				<div class="drawer-content flex flex-col">
					<!-- Navbar -->
					<div class="w-full navbar bg-base-300">
						<div class="flex-none lg:hidden">
							<label for="drawer-sidebar-toggle" aria-label="open sidebar" class="btn btn-square btn-ghost">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block h-6 w-6 stroke-current">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
								</svg>
							</label>
						</div>
						<div class="mx-2 flex-1 px-2">Trash</div>
						<div class="hidden flex-none lg:block">
							<ul class="menu menu-horizontal">
								<li><a href="/">Home</a></li>
								<li><a href="/trash">Trash</a></li>
							</ul>
						</div>
					</div>
					<!-- Page content here -->
					<div class="flex-1 p-4">
						<div class="bg-base-100 min-h-full rounded-lg shadow-lg p-4">
							if len(data.Assets) > 0 {
								<!-- Action Buttons -->
								<div id="action-bar" class="mb-4 p-4 bg-base-200 rounded-lg">
									<div class="flex gap-2 items-center">
										<span id="selected-count" class="text-sm font-medium">No assets selected</span>
										<div class="flex gap-2 ml-auto">
											<button id="restore-btn" class="btn btn-sm btn-success hidden">
												<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-4 h-4 stroke-current">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
												</svg>
												Restore
											</button>
										</div>
									</div>
								</div>
								<div class="mb-4">
									<p class="text-sm text-base-content/70">
										Items in trash are permanently deleted after 30 days. You can restore them by moving them back to your library.
									</p>
								</div>
								<style>
            .has-selection .asset-checkbox {
              opacity: 1 !important;
            }
          </style>
								<div class="flex flex-wrap gap-2 after:content-[''] after:flex-grow-[999]">
									for _, asset := range data.Assets {
										<div class="photo-item h-60 flex-grow relative overflow-hidden rounded-lg bg-base-100 shadow-lg select-none group opacity-70 has-[:checked]:ring-2 has-[:checked]:ring-primary has-[:checked]:opacity-100" data-asset-id={ asset.PublicID }>
											<input type="checkbox" class="asset-checkbox checkbox checkbox-sm absolute top-2 left-2 z-10 border-2 border-white/80 bg-black/30 backdrop-blur transition-all duration-100 checked:bg-primary checked:border-primary opacity-0 group-hover:opacity-100"/>
											<img src={ "/assets/" + asset.PublicID + "?width=500" } alt={ asset.Filename } loading="lazy" class="h-full w-full object-cover min-w-full"/>
											<div class="absolute top-0 left-0 right-0 bg-gradient-to-b from-black/40 to-transparent p-4 pb-3 text-white opacity-100 group-hover:opacity-100 transition-opacity duration-300">
												<div class="text-sm font-semibold mb-1 truncate">{ asset.Filename }</div>
												<div class="text-xs opacity-90">Deleted</div>
											</div>
										</div>
									}
								</div>
							} else {
								<div class="flex flex-col items-center justify-center h-96">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-16 h-16 stroke-current text-base-content/50 mb-4">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
									<h2 class="text-xl font-semibold text-base-content/70 mb-2">Trash is empty</h2>
									<p class="text-base-content/50">Deleted assets will appear here</p>
								</div>
							}
						</div>
					</div>
				</div>
				<div class="drawer-side">
					<label for="drawer-sidebar-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
					<ul class="menu bg-base-300 text-base-content min-h-full min-w-[240px] p-4">
						<li><a href="/" class="text-2xl">Alcoves</a></li>
						<li class="text-lg"><a href="/" class="menu-item">Home</a></li>
						<li class="text-lg"><a href="/trash" class="menu-item active">Trash</a></li>
					</ul>
				</div>
			</div>
			<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.asset-checkbox');
    const actionBar = document.getElementById('action-bar');
    const selectedCount = document.getElementById('selected-count');
    const restoreBtn = document.getElementById('restore-btn');
    
    let lastChecked = null;
    
    function updateUI() {
        const selected = document.querySelectorAll('.asset-checkbox:checked');
        const count = selected.length;
        const gallery = document.querySelector('.flex.flex-wrap');
        
        // Update text and button visibility
        if (count === 0) {
            selectedCount.textContent = 'No assets selected';
            restoreBtn.classList.add('hidden');
            gallery.classList.remove('has-selection');
        } else {
            selectedCount.textContent = count === 1 ? '1 asset selected' : `${count} assets selected`;
            restoreBtn.classList.remove('hidden');
            gallery.classList.add('has-selection');
        }
    }
    
    checkboxes.forEach((checkbox, index) => {
        checkbox.addEventListener('click', function(e) {
            e.stopPropagation();
            
            const isShiftClick = e.shiftKey && lastChecked !== null;
            
            if (isShiftClick) {
                const start = Math.min(lastChecked, index);
                const end = Math.max(lastChecked, index);
                
                // Set all checkboxes in range to the same state as this checkbox
                for (let i = start; i <= end; i++) {
                    checkboxes[i].checked = this.checked;
                }
            }
            
            lastChecked = index;
            updateUI();
        });
    });

    // Add click handlers to photo items for selection when items are already selected
    document.querySelectorAll('.photo-item').forEach((item, index) => {
        item.addEventListener('click', function(e) {
            const gallery = document.querySelector('.flex.flex-wrap');
            const hasSelection = gallery.classList.contains('has-selection');
            
            if (hasSelection) {
                e.preventDefault();
                e.stopPropagation();
                
                // Toggle the checkbox for this item
                const checkbox = item.querySelector('.asset-checkbox');
                checkbox.checked = !checkbox.checked;
                lastChecked = index;
                updateUI();
            }
        });
    });
    
    if (restoreBtn) {
        restoreBtn.addEventListener('click', function() {
            const selected = Array.from(document.querySelectorAll('.asset-checkbox:checked'))
                .map(cb => cb.closest('.photo-item').dataset.assetId);
            
            if (selected.length === 0) return;
            
            if (confirm(`Restore ${selected.length} asset(s) from trash?`)) {
                fetch('/assets/restore', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ assetIds: selected })
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Failed to restore assets');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Failed to restore assets');
                });
            }
        });
    }
});
</script>
		</body>
	</html>
}
