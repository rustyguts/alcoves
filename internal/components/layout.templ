package components

import "time"
import "fmt"

type Asset struct {
	PublicID string
	Filename string
}

type LayoutData struct {
	Title     string
	UserEmail string
	Theme     string
	CreatedAt time.Time
	Assets    []Asset
}

func getAssetPreviewURL(publicID string) string {
	str := fmt.Sprintf("/media/%s", publicID)
	return str
}

func getAssetURL(publicID string, width int) string {
	str := fmt.Sprintf("/assets/%s?width=%d", publicID, width)
	return str
}

templ Layout(data LayoutData) {
	@Root(data.Title, data.Theme) {
		<div class="drawer lg:drawer-open">
			<input id="drawer-sidebar-toggle" type="checkbox" class="drawer-toggle"/>
			<div class="bg-base-300 drawer-content flex flex-col">
				<div class="navbar bg-base-300 sticky top-0 z-30">
					<div class="w-10 h-10 flex-none lg:hidden">
						<label for="drawer-sidebar-toggle" aria-label="open sidebar" class="btn btn-square btn-ghost">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								class="inline-block h-6 w-6 stroke-current"
							>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
						</label>
					</div>
					<div class="flex justify-end w-full">
						<div class="mr-4 flex items-center gap-2">
							@UploadModal()
							<button
								id="upload-btn"
								class="w-10 h-10 btn btn-primary btn-ghost btn-circle"
								onclick="upload_modal.showModal()"
								aria-label="Upload"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
									class="size-6"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
								</svg>
							</button>
							<button
								id="deselect-btn-nav"
								class="w-10 h-10 btn btn-ghost btn-primary btn-circle hidden"
								aria-label="Deselect All"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
									class="size-6"
								>
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
								</svg>
							</button>
							<button
								id="download-btn-nav"
								class="w-10 h-10 btn btn-ghost btn-primary btn-circle hidden"
								aria-label="Download"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
									class="size-6"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M12 9.75v6.75m0 0-3-3m3 3 3-3m-8.25 6a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"
									></path>
								</svg>
							</button>
							<button id="delete-btn-nav" class="w-10 h-10 btn btn-ghost btn-error btn-circle hidden" aria-label="Delete">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									fill="none"
									viewBox="0 0 24 24"
									stroke-width="1.5"
									stroke="currentColor"
									class="size-6"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
									></path>
								</svg>
							</button>
							<div id="profile-dropdown" class="dropdown dropdown-end">
								<div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar avatar-placeholder">
									<div class="bg-neutral text-neutral-content w-12 rounded-full">
										<span class="text-xl">{ string(data.UserEmail[0]) }</span>
									</div>
								</div>
								<div tabindex="0" class="dropdown-content z-[1] mt-3 w-80 p-4 shadow-xl bg-base-100 rounded-box">
									<!-- Profile Section -->
									<div class="mb-4">
										<div class="flex items-center gap-3 mb-3">
											<div class="avatar avatar-placeholder">
												<div class="bg-neutral text-neutral-content w-12 rounded-full">
													<span class="text-xl">{ string(data.UserEmail[0]) }</span>
												</div>
											</div>
											<div>
												<h3 class="font-semibold">{ data.UserEmail }</h3>
												<p class="text-sm text-base-content/70">
													Member Since { data.CreatedAt.Format("January 2, 2006") }
												</p>
											</div>
										</div>
									</div>
									<!-- Theme Settings -->
									<div class="mb-4">
										<h4 class="font-medium mb-2 flex items-center gap-2">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												fill="none"
												viewBox="0 0 24 24"
												class="inline-block h-4 w-4 stroke-current"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
												></path>
											</svg>
											Theme
										</h4>
										<form action="/update-theme" method="post">
											<div class="grid grid-cols-2 gap-2">
												<label class="label cursor-pointer justify-start gap-2 p-2 rounded hover:bg-base-200">
													<input
														type="radio"
														name="theme"
														class="radio radio-sm theme-controller"
														aria-label="Light"
														value="light"
														if data.Theme=="light" {
															checked
														}
														onchange="this.form.submit()"
													/>
													<span class="label-text text-sm">Light</span>
												</label>
												<label class="label cursor-pointer justify-start gap-2 p-2 rounded hover:bg-base-200">
													<input
														type="radio"
														name="theme"
														class="radio radio-sm theme-controller"
														aria-label="Dark"
														value="dark"
														if data.Theme=="dark" {
															checked
														}
														onchange="this.form.submit()"
													/>
													<span class="label-text text-sm">Dark</span>
												</label>
												<label class="label cursor-pointer justify-start gap-2 p-2 rounded hover:bg-base-200">
													<input
														type="radio"
														name="theme"
														class="radio radio-sm theme-controller"
														aria-label="Cupcake"
														value="cupcake"
														if data.Theme=="cupcake" {
															checked
														}
														onchange="this.form.submit()"
													/>
													<span class="label-text text-sm">Cupcake</span>
												</label>
												<label class="label cursor-pointer justify-start gap-2 p-2 rounded hover:bg-base-200">
													<input
														type="radio"
														name="theme"
														class="radio radio-sm theme-controller"
														aria-label="Sunset"
														value="sunset"
														if data.Theme=="sunset" {
															checked
														}
														onchange="this.form.submit()"
													/>
													<span class="label-text text-sm">Sunset</span>
												</label>
											</div>
										</form>
									</div>
									<!-- Logout Button -->
									<form action="/logout" method="post" class="w-full">
										<button type="submit" class="btn btn-outline btn-error w-full">
											<svg
												xmlns="http://www.w3.org/2000/svg"
												fill="none"
												viewBox="0 0 24 24"
												class="inline-block h-4 w-4 stroke-current"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
												></path>
											</svg>
											Log Out
										</button>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="flex flex-col h-[calc(100vh-64px)] px-4 pb-4">
					<div class="p-4 rounded-xl bg-base-200 overflow-y-auto flex-1 pr-2">
						<style>
							.has-selection .asset-checkbox {
								opacity: 1 !important;
							}
						</style>
						<div>
							@Assets()
						</div>
						<div class="flex flex-wrap gap-2 after:content-[''] after:flex-grow-[999]">
							for _, item := range data.Assets {
								<div
									class="photo-item h-60 flex-grow relative overflow-hidden rounded-lg bg-base-100 shadow-lg select-none group has-[:checked]:ring-2 has-[:checked]:ring-primary"
									data-asset-id={ item.PublicID }
								>
									<input
										type="checkbox"
										class="asset-checkbox checkbox checkbox-md hover:border-primary absolute top-2 left-2 z-10 border-2 border-white/80 bg-black/30 backdrop-blur transition-all duration-100 checked:bg-primary checked:border-primary opacity-0 group-hover:opacity-100"
									/>
									<a href={ getAssetPreviewURL(item.PublicID) } class="photo-link block w-full h-full">
										<img
											src={ getAssetURL(item.PublicID, 500) }
											alt={ item.Filename }
											loading="lazy"
											class="h-full w-full object-cover min-w-full"
										/>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
			<div class="drawer-side z-10">
				<label for="drawer-sidebar-toggle" aria-label="close sidebar" class="drawer-overlay"></label>
				<div class="bg-base-300 min-h-full min-w-[240px]">
					<div class="flex justify-start items-center text-2xl h-16 p-2 pl-6">
						<a href="/">Alcoves</a>
					</div>
					<ul class="menu menu-md text-base-content gap-2 w-full p-2">
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Home
							</a>
						</li>
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Recent
							</a>
						</li>
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Starred
							</a>
						</li>
						<li class="text-md">
							<a href="/trash" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-icon lucide-trash"><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
								Trash
							</a>
						</li>
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Documents
							</a>
						</li>
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Photos
							</a>
						</li>
						<li class="text-md">
							<a href="/" class="menu-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house-icon lucide-house"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
								Bookmarks
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
		<script>
			// Save scroll position when navigating to media
			function saveScrollPosition() {
				const scrollContainer = document.querySelector('.overflow-y-auto');
				if (scrollContainer) {
					sessionStorage.setItem('mediaGalleryScrollPosition', scrollContainer.scrollTop);
				}
			}

			// Restore scroll position when returning from media
			function restoreScrollPosition() {
				const scrollContainer = document.querySelector('.overflow-y-auto');
				const savedPosition = sessionStorage.getItem('mediaGalleryScrollPosition');
				if (scrollContainer && savedPosition) {
					scrollContainer.scrollTop = parseInt(savedPosition);
					// Clear the saved position after restoring
					sessionStorage.removeItem('mediaGalleryScrollPosition');
				}
			}

			document.addEventListener('DOMContentLoaded', function () {
				// Restore scroll position if returning from media viewer
				if (document.referrer && document.referrer.includes('/media/')) {
					requestAnimationFrame(() => {
						restoreScrollPosition();
					});
				}
				const checkboxes = document.querySelectorAll('.asset-checkbox');
				const downloadBtn = document.getElementById('download-btn-nav');
				const deleteBtn = document.getElementById('delete-btn-nav');
				const deselectBtn = document.getElementById('deselect-btn-nav');
				const uploadBtn = document.getElementById('upload-btn');
				const profileDropdown = document.getElementById('profile-dropdown');

				let lastChecked = null;

				function updateUI() {
					const selected = document.querySelectorAll('.asset-checkbox:checked');
					const count = selected.length;
					const gallery = document.querySelector('.flex.flex-wrap');

					// Update button visibility based on selection state
					if (count === 0) {
						// No selection: show upload and profile, hide delete, download, and deselect
						uploadBtn.classList.remove('hidden');
						profileDropdown.classList.remove('hidden');
						downloadBtn.classList.add('hidden');
						deleteBtn.classList.add('hidden');
						deselectBtn.classList.add('hidden');
						gallery.classList.remove('has-selection');
					} else {
						// Items selected: show delete, download, and deselect, hide upload and profile
						uploadBtn.classList.add('hidden');
						profileDropdown.classList.add('hidden');
						downloadBtn.classList.remove('hidden');
						deleteBtn.classList.remove('hidden');
						deselectBtn.classList.remove('hidden');
						gallery.classList.add('has-selection');
					}
				}

				checkboxes.forEach((checkbox, index) => {
					checkbox.addEventListener('click', function (e) {
						e.stopPropagation();

						const isShiftClick = e.shiftKey && lastChecked !== null;

						if (isShiftClick) {
							const start = Math.min(lastChecked, index);
							const end = Math.max(lastChecked, index);

							// Set all checkboxes in range to the same state as this checkbox
							for (let i = start; i <= end; i++) {
								checkboxes[i].checked = this.checked;
							}
						}

						lastChecked = index;
						updateUI();
					});
				});

				// Add click handlers to photo items for selection when items are already selected
				document.querySelectorAll('.photo-item').forEach((item, index) => {
					item.addEventListener('click', function (e) {
						const gallery = document.querySelector('.flex.flex-wrap');
						const hasSelection = gallery.classList.contains('has-selection');

						if (hasSelection) {
							e.preventDefault();
							e.stopPropagation();

							// Toggle the checkbox for this item
							const checkbox = item.querySelector('.asset-checkbox');
							checkbox.checked = !checkbox.checked;
							lastChecked = index;
							updateUI();
						}
					});
				});

				deleteBtn.addEventListener('click', function () {
					const selected = Array.from(document.querySelectorAll('.asset-checkbox:checked'))
						.map(cb => cb.closest('.photo-item').dataset.assetId);

					if (selected.length === 0) return;

					if (confirm(`Delete ${selected.length} asset(s)? They will be moved to trash.`)) {
						fetch('/assets/delete', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({ assetIds: selected })
						})
							.then(response => {
								if (response.ok) {
									checkboxes.forEach(cb => cb.checked = false);
									location.reload();
								} else {
									alert('Failed to delete assets');
								}
							})
							.catch(error => {
								console.error('Error:', error);
								alert('Failed to delete assets');
							});
					}
				});

				downloadBtn.addEventListener('click', function () {
					const selected = Array.from(document.querySelectorAll('.asset-checkbox:checked'))
						.map(cb => cb.closest('.photo-item').dataset.assetId);

					if (selected.length === 0) return;

					if (selected.length === 1) {
						window.location.href = `/assets/download/${selected[0]}`;
					} else {
						window.location.href = `/assets/download?ids=${selected.join(',')}`;
					}
				});

				deselectBtn.addEventListener('click', function () {
					checkboxes.forEach(cb => cb.checked = false);
					updateUI();
				});

				// Add click event listeners to photo links to save scroll position
				document.querySelectorAll('.photo-link').forEach(link => {
					link.addEventListener('click', function (e) {
						// Only save scroll position if not in selection mode
						const gallery = document.querySelector('.flex.flex-wrap');
						if (!gallery.classList.contains('has-selection')) {
							saveScrollPosition();
						}
					});
				});
			});
		</script>
	}
}
