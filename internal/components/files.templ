package components

import (
	"fmt"
	"github.com/rustyguts/alcoves/internal/models"
	"strings"
)

const (
	AssetTypeFilePDF string = "pdf"
	AssetTypeFile    string = "txt"
	AssetTypeImage   string = "image"
	AssetTypeVideo   string = "video"
)

type AssetsData struct {
	Assets []models.File
}

func getFileType(filename string, contentType string) string {
	lower := strings.ToLower(filename)
	if strings.HasSuffix(lower, ".pdf") {
		return AssetTypeFilePDF
	}
	if strings.HasPrefix(contentType, "image/") {
		return AssetTypeImage
	}
	return AssetTypeFile
}

func formatFileSize(size int64) string {
	const unit = 1024
	if size < unit {
		return fmt.Sprintf("%d B", size)
	}
	div, exp := int64(unit), 0
	for n := size / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(size)/float64(div), "KMGTPE"[exp])
}

func formatDate(file models.File) string {
	return file.CTime.Format("Jan 02, 2006")
}

templ IconAndName(name string, filetype string) {
	<div class="flex w-full">
		<div class="ml-2 mr-4 h-full flex items-center justify-center">
			switch filetype {
				case AssetTypeFilePDF:
					@TextFileIcon("22", "22", "1.5")
				case AssetTypeFile:
					@FileIcon("22", "22", "1.5")
				case AssetTypeImage:
					@ImageFileIcon("22", "22", "1.5")
				default:
					@FileIcon("22", "22", "1.5")
			}
		</div>
		<div class="truncate">
			{ name }
		</div>
	</div>
}

// Shared context menu component
templ AssetsContextMenu(idPrefix string) {
	<div
		id={ idPrefix + "-context-menu" }
		class="hidden fixed z-50 min-w-[180px] bg-base-100 border border-base-300 rounded-lg shadow-lg"
	>
		<div
			class="px-4 py-2 cursor-pointer flex items-center gap-3 transition-colors duration-150 text-sm hover:bg-base-200 rounded-t-lg"
			onclick="window.assetsDownloadSelected(); window.assetsHideContextMenu()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
			<span>Download</span>
		</div>
		<div class="h-px bg-base-300 my-1"></div>
		<div
			class="px-4 py-2 cursor-pointer flex items-center gap-3 transition-colors duration-150 text-sm hover:bg-base-200 rounded-b-lg text-error"
			onclick="window.assetsDeleteSelected(); window.assetsHideContextMenu()"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
			<span>Move to trash</span>
		</div>
	</div>
}

// Shared assets script - handles both list and thumbnail views
templ AssetsScript() {
	<script>
		(function() {
			// Selection state stored on body for persistence
			if (!document.body._assetsState) {
				document.body._assetsState = {
					selected: new Set(),
					lastIndex: -1
				};
			}
			const state = document.body._assetsState;

			// Selection management
			window.assetsGetSelected = () => Array.from(state.selected);

			// Update Datastar signal for selection count
			function updateSelectionSignal() {
				const signalEl = document.querySelector('[data-signals*="selectedCount"]');
				if (signalEl && signalEl._dsSignals) {
					signalEl._dsSignals.selectedCount.value = state.selected.size;
				}
			}

			window.assetsSetSelected = function(el, selected) {
				const id = el.dataset.assetId;
				if (selected) {
					state.selected.add(id);
					el.classList.add('bg-primary/20');
				} else {
					state.selected.delete(id);
					el.classList.remove('bg-primary/20');
				}
				updateSelectionSignal();
			};

			window.assetsIsSelected = (el) => state.selected.has(el.dataset.assetId);

			window.assetsClearSelection = function() {
				state.selected.clear();
				document.querySelectorAll('[data-asset-id]').forEach(el => {
					el.classList.remove('bg-primary/20');
				});
				updateSelectionSignal();
			};

			window.assetsSelectAll = function() {
				document.querySelectorAll('[data-asset-id]').forEach(el => {
					state.selected.add(el.dataset.assetId);
					el.classList.add('bg-primary/20');
				});
				updateSelectionSignal();
			};

			// Actions
			window.assetsDeleteSelected = function() {
				const selected = window.assetsGetSelected();
				if (selected.length === 0) return;

				if (confirm(`Move ${selected.length} file(s) to trash?`)) {
					fetch('/assets/delete', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(selected)
					}).then(r => r.ok ? location.reload() : alert('Failed to delete files'))
					  .catch(() => alert('Failed to delete files'));
				}
			};

			window.assetsDownloadSelected = function() {
				const selected = window.assetsGetSelected();
				if (selected.length === 0) return;

				location.href = selected.length === 1
					? '/assets/download/' + selected[0]
					: '/assets/download?ids=' + selected.join(',');
			};

			// Open item on double-click
			window.assetsOpenItem = function(el) {
				location.href = '/media/' + el.dataset.assetId;
			};

			// Click handler for asset items
			window.assetsHandleClick = function(e, el) {
				const items = Array.from(document.querySelectorAll('[data-asset-id]'));
				const index = items.indexOf(el);

				if (e.shiftKey && state.lastIndex >= 0) {
					// Shift+click: select range
					const [start, end] = [Math.min(state.lastIndex, index), Math.max(state.lastIndex, index)];
					items.forEach((item, i) => {
						if (i >= start && i <= end) window.assetsSetSelected(item, true);
					});
				} else if (e.ctrlKey || e.metaKey) {
					// Ctrl/Cmd+click: toggle
					window.assetsSetSelected(el, !window.assetsIsSelected(el));
				} else {
					// Regular click: select only this
					window.assetsClearSelection();
					window.assetsSetSelected(el, true);
				}
				state.lastIndex = index;
			};

			// Context menu
			window.assetsShowContextMenu = function(e, el) {
				e.preventDefault();
				
				if (!window.assetsIsSelected(el)) {
					window.assetsClearSelection();
					window.assetsSetSelected(el, true);
				}

				const menu = el.closest('[id$="-container"]').querySelector('[id$="-context-menu"]');
				if (!menu) return;

				menu.style.left = Math.min(e.clientX, window.innerWidth - 180) + 'px';
				menu.style.top = Math.min(e.clientY, window.innerHeight - 100) + 'px';
				menu.classList.remove('hidden');
			};

			window.assetsHideContextMenu = function() {
				document.querySelectorAll('[id$="-context-menu"]').forEach(m => m.classList.add('hidden'));
			};

			// Global listeners (only attach once)
			if (!document.body._assetsListenersAttached) {
				document.body._assetsListenersAttached = true;

				document.addEventListener('click', function(e) {
					if (!e.target.closest('[id$="-context-menu"]')) {
						window.assetsHideContextMenu();
					}
				});

				document.addEventListener('keydown', function(e) {
					if ((e.ctrlKey || e.metaKey) && e.key === 'a') {
						if (document.querySelectorAll('[data-asset-id]').length > 0) {
							e.preventDefault();
							window.assetsSelectAll();
						}
					}
					if (e.key === 'Escape') {
						window.assetsClearSelection();
						window.assetsHideContextMenu();
					}
					if (e.key === 'Delete' || e.key === 'Backspace') {
						if (state.selected.size > 0 && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
							e.preventDefault();
							window.assetsDeleteSelected();
						}
					}
				});
			}
		})();
	</script>
}

// AssetsList shows files in a row-based table format
templ AssetsList(data AssetsData) {
	<div id="assets-container">
		@AssetsContextMenu("list")
		<div class="overflow-auto max-h-[calc(100vh-12rem)]">
			<table class="table table-auto w-full select-none" id="files-table">
				<thead class="sticky top-0 bg-base-200 z-10">
					<tr>
						<th class="text-left">Name</th>
						<th class="w-[120px] whitespace-nowrap">Size</th>
						<th class="w-[160px] whitespace-nowrap">Date</th>
						<th class="w-[50px] whitespace-nowrap">
							@SortIcon("18", "18", "3")
						</th>
					</tr>
				</thead>
				<tbody>
					if len(data.Assets) == 0 {
						<tr>
							<td colspan="4" class="text-center py-8 text-base-content/60">
								No files in your library. Click "Upload" to add files.
							</td>
						</tr>
					}
					for _, asset := range data.Assets {
						<tr
							class="h-10 max-h-10 cursor-pointer hover:saturate-150"
							data-asset-id={ asset.PublicID }
							tabindex="0"
							onclick="window.assetsHandleClick(event, this)"
							ondblclick="window.assetsOpenItem(this)"
							oncontextmenu="window.assetsShowContextMenu(event, this)"
						>
							<td>
								@IconAndName(asset.Filename, getFileType(asset.Filename, asset.Type))
							</td>
							<td>
								<div>{ formatFileSize(asset.Size) }</div>
							</td>
							<td>{ formatDate(asset) }</td>
							<td>
								@MoreIcon("18", "18", "2")
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@AssetsScript()
	</div>
}

// AssetsThumbnail shows files in a card-based grid gallery
templ AssetsThumbnail(data AssetsData) {
	<div id="assets-thumbnail-container">
		@AssetsContextMenu("thumb")
		if len(data.Assets) == 0 {
			<div class="flex flex-col items-center justify-center py-16 text-base-content/60">
				<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mb-4 opacity-50">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
					<polyline points="14 2 14 8 20 8"></polyline>
				</svg>
				<p class="text-lg font-medium mb-2">No files in your library</p>
				<p class="text-sm mb-4">Click "Upload" to add files.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-4">
				for _, asset := range data.Assets {
					<div
						class="card card-compact bg-base-100 shadow-sm hover:shadow-md transition-all duration-200 cursor-pointer group p-2"
						data-asset-id={ asset.PublicID }
						tabindex="0"
						onclick="window.assetsHandleClick(event, this)"
						ondblclick="window.assetsOpenItem(this)"
						oncontextmenu="window.assetsShowContextMenu(event, this)"
					>
						<figure class="aspect-video bg-base-200 rounded-lg relative overflow-hidden">
							if strings.HasPrefix(asset.Type, "image/") {
								<img
									src={ getAssetURL(asset.PublicID, 400) }
									alt={ asset.Filename }
									class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
									loading="lazy"
								/>
							} else {
								<div class="w-full h-full flex items-center justify-center">
									<div class="p-4 rounded-lg bg-base-300/50">
										switch getFileType(asset.Filename, asset.Type) {
											case AssetTypeFilePDF:
												@TextFileIcon("48", "48", "1.5")
											case AssetTypeImage:
												@ImageFileIcon("48", "48", "1.5")
											case AssetTypeVideo:
												@VideoFileIcon("48", "48", "1.5")
											default:
												@FileIcon("48", "48", "1.5")
										}
									</div>
								</div>
							}
						</figure>
						<div class="card-body p-2 pt-3">
							<h3 class="card-title text-sm font-medium truncate" title={ asset.Filename }>
								{ asset.Filename }
							</h3>
							<div class="flex items-center justify-between text-xs text-base-content/60">
								<span>{ formatFileSize(asset.Size) }</span>
								<span>{ formatDate(asset) }</span>
							</div>
						</div>
					</div>
				}
			</div>
		}
		@AssetsScript()
	</div>
}
