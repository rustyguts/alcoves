package components

type UploadModalData struct {
	LibraryPublicID string
}

templ UploadModal(data UploadModalData) {
	<dialog id="upload_modal" class="modal" closedby="any">
		<div class="modal-box max-w-4xl">
			<!-- Modal Header -->
			<div class="flex items-center justify-between mb-6">
				<h3 class="font-bold text-xl flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="17 8 12 3 7 8"></polyline>
						<line x1="12" y1="3" x2="12" y2="15"></line>
					</svg>
					Upload Files
				</h3>
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost">✕</button>
				</form>
			</div>
			<!-- Uploader Container -->
			<div id="uploader"></div>
			<input type="hidden" id="libraryPublicID" value={ data.LibraryPublicID }/>
			<!-- Modal Actions -->
			<div class="modal-action">
				<form method="dialog">
					<button class="btn btn-ghost" id="close_upload_modal">Cancel</button>
				</form>
			</div>
		</div>
		<!-- External Resources -->
		<link href="/css/uppy.min.css" rel="stylesheet"/>
		<script type="module">
			import { Uppy, Dashboard, XHRUpload } from "/js/uppy.min.mjs"

			// Prevent multiple initializations
			if (window.uppyInstance) {
				window.uppyInstance.close();
				window.uppyInstance = null;
			}

			// Initialize Uppy
			const uppy = new Uppy({
				id: 'upload_modal_uppy',
				restrictions: {
					maxNumberOfFiles: 5000
				},
				autoProceed: false,
				debug: false
			})
			.use(Dashboard, {
				inline: true,
				target: '#uploader',
				showProgressDetails: true,
				proudlyDisplayPoweredByUppy: false,
				height: 400,
				note: 'Upload up to 5000 files',
				theme: 'auto'
			})
			.use(XHRUpload, {
				endpoint: '/assets/upload',
				fieldName: 'files',
				formData: true,
				bundle: true,
				allowedMetaFields: ['libraryPublicID']
			})

			// Store instance globally to prevent duplicates
			window.uppyInstance = uppy;

			// Set metadata before upload
			const libraryPublicID = document.getElementById('libraryPublicID')?.value;
			if (libraryPublicID) {
				uppy.setMeta({ libraryPublicID: libraryPublicID });
			}

			// Handle successful upload
			uppy.on('complete', (result) => {
				console.log('Upload complete:', result)
				if (result.successful && result.successful.length > 0) {
					window.location.reload()
				}
			})

			// Handle upload errors
			uppy.on('upload-error', (file, error, response) => {
				console.error('Upload error:', error)
			})

			// Cleanup on modal close
			const closeButton = document.getElementById('close_upload_modal');
			const modal = document.getElementById('upload_modal');
			
			if (closeButton) {
				closeButton.addEventListener('click', () => {
					uppy.cancelAll()
				})
			}

			if (modal) {
				modal.addEventListener('close', () => {
					uppy.cancelAll()
				})
			}
		</script>
	</dialog>
}
