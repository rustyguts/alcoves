{% load static %}

{% block extra_css %}
<link href="https://releases.transloadit.com/uppy/v4.13.3/uppy.min.css" rel="stylesheet">
<script src="https://releases.transloadit.com/uppy/v4.13.3/uppy.min.js"></script>
{% endblock %}

{% block content %}
<div class="container">
  <h1>File Upload</h1>
  <div id="drag-drop-area"></div>
  <div id="upload-results" class="mt-3"></div>
</div>
{% endblock %}

{% block extra_js %}
<script type="module">
  import { Uppy, DragDrop, XHRUpload } from "https://releases.transloadit.com/uppy/v4.13.3/uppy.min.mjs";

  const uppy = new Uppy({
    endpoint: '/upload',
    autoProceed: true,
    restrictions: {
      maxFileSize: 50 * 1024 * 1024, // 50MB
      maxNumberOfFiles: 100,
      allowedFileTypes: ['image/*']
    }
  })

  uppy.use(DragDrop, {
    target: '#drag-drop-area',
    note: 'Upload files up to 10MB'
  });

  uppy.use(XHRUpload, {
    endpoint: '{% url "upload_file" %}',
    formData: true,
    fieldName: 'files[]',
    headers: {
      'X-CSRFToken': '{{ csrf_token }}'
    }
  });

  // Handle successful uploads
  uppy.on('upload-success', (file, response) => {
    console.log('Upload successful:', file.name);
    const resultsEl = document.getElementById('upload-results');
    resultsEl.innerHTML += `<div class="alert alert-success">Successfully uploaded ${file.name}</div>`;

    // Explicitly dispatch the assets-created event that HTMX is listening for
    document.body.dispatchEvent(new Event('assets-created'));
  });

  // Handle upload errors
  uppy.on('upload-error', (file, error, response) => {
    console.error('Upload error:', error);
    const resultsEl = document.getElementById('upload-results');
    resultsEl.innerHTML += `<div class="alert alert-danger">Error uploading ${file.name}: ${error}</div>`;
  });
</script>
{% endblock %}