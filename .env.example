# Alcoves environment variables
# Copy this file to `.env` and fill in your values.
# Every variable is prefixed with ALCOVES_ so they nest cleanly in container envs.

# =============================================================================
# Runtime
# =============================================================================

# Which capabilities this instance runs:
#   all    — API + background workers (default, recommended for local dev)
#   api    — API/web server only
#   worker — background workers only (HTTP port stays open for health checks)
ALCOVES_MODE=all

# Environment name: development | production
ALCOVES_ENV=development

# Public base URL — used for OAuth redirect URIs and links in emails.
#   Dev default: http://localhost:5173 (Vite dev server)
#   Production:  https://yourdomain.com
ALCOVES_BASE_URL=http://localhost:5173

# =============================================================================
# Database + queue
# =============================================================================

# PostgreSQL connection string.
# Format: postgres://user:pass@host:port/database
ALCOVES_DATABASE_URL=postgres://postgres:postgres@localhost:5455/alcoves

# Dragonfly / Redis for async jobs (face detection, transcoding, etc.)
ALCOVES_QUEUE_HOST=localhost
ALCOVES_QUEUE_PORT=6389
ALCOVES_QUEUE_PASSWORD=

# =============================================================================
# Session
# =============================================================================

# AES-GCM key for session cookies. Must be ≥32 bytes.
# Generate: openssl rand -base64 32
ALCOVES_SESSION_SECRET=alcoves-dev-secret-key-change-in-production!!

# =============================================================================
# MCP server (Model Context Protocol)
# =============================================================================

# Enable the HTTP MCP transport at POST /api/mcp (authenticated by a Bearer
# personal access token). Off by default.
# ALCOVES_MCP_HTTP_ENABLED=true

# Personal access token the stdio MCP server (alcoves-mcp) authenticates as.
# Mint one with: alcoves-mcp create-token --email you@example.com --name laptop
# ALCOVES_MCP_TOKEN=alc_pat_...

# HMAC key for signed curl upload/download URLs. Falls back to
# ALCOVES_SESSION_SECRET when unset.
# ALCOVES_MCP_SIGNING_SECRET=

# =============================================================================
# Storage
# =============================================================================

# Storage backend: local | s3
ALCOVES_STORAGE_DRIVER=local

# Local filesystem paths (used when driver=local).
ALCOVES_STORAGE_PATH=./data
ALCOVES_AVATAR_STORAGE_PATH=
ALCOVES_CACHE_STORAGE_PATH=

# S3-compatible storage (used when driver=s3).
# ALCOVES_S3_BUCKET=
# ALCOVES_S3_REGION=
# ALCOVES_S3_ENDPOINT=
# ALCOVES_S3_ACCESS_KEY_ID=
# ALCOVES_S3_SECRET_ACCESS_KEY=

# =============================================================================
# Google OAuth (optional)
# =============================================================================
#
# Enables the "Continue with Google" button on the login/register pages.
# Setup:
#   1. Visit https://console.cloud.google.com/ → APIs & Services → Credentials.
#   2. Create an OAuth client ID of type "Web application".
#   3. Add the authorized redirect URI:
#        {ALCOVES_BASE_URL}/api/auth/google/callback
#      e.g. http://localhost:5173/api/auth/google/callback   (dev)
#           https://yourdomain.com/api/auth/google/callback  (prod)
#   4. Paste the client ID + secret below.
#
# The frontend auto-detects availability via GET /api/auth/providers — the
# button renders only when both values are set.

ALCOVES_OAUTH_GOOGLE_CLIENT_ID=
ALCOVES_OAUTH_GOOGLE_CLIENT_SECRET=

# =============================================================================
# Face recognition tuning (optional)
# =============================================================================

# SCRFD detector min confidence.
ALCOVES_FACE_DETECTION_MIN_SCORE=0.28

# Max cosine distance for a face match (lower = stricter).
ALCOVES_FACE_RECOGNITION_MAX_DISTANCE=0.42

# Min faces before a new person cluster is created.
ALCOVES_FACE_RECOGNITION_MIN_FACES=3

# Number of nearest-neighbor candidates considered during assignment.
ALCOVES_FACE_RECOGNITION_NEIGHBOR_LOOKUP=80

# =============================================================================
# Inference models (transcription + audio tagging)
# =============================================================================
#
# All of these are *boot-time fallbacks*. Admins can override at runtime
# from /admin → Inference Models; the worker reads admin settings first
# and falls back here when empty (fresh installs, tests).
#
# Allow-lists:
#   ALCOVES_WHISPER_MODEL    → backend/internal/services/transcribe/whisper_models.go
#   ALCOVES_WHISPER_LANGUAGE → same file (auto, en, fr, de, es, it, pt, nl, ja, zh, ko, ru)
#   active audio tagger ID   → backend/internal/services/audiodetection/registry.go

# whisper.cpp GGML name (without the "ggml-" prefix or ".bin" suffix).
ALCOVES_WHISPER_MODEL=large-v3

# Language hint. "auto" lets whisper.cpp detect.
ALCOVES_WHISPER_LANGUAGE=auto

# Silero VAD model used to drop non-speech regions before decoding.
# Empty string disables VAD; not recommended (repetition-loop hallucination
# returns on gameplay/music/silence audio — see docs/models.md §1).
ALCOVES_WHISPER_VAD_MODEL=silero-v6.2.0

# Base URL where the worker fetches `ggml-<model>.bin`.
ALCOVES_WHISPER_MODEL_BASE_URL=https://s3.rustyguts.net/models

# Filesystem caches for downloaded models. Default: ./data/.whisper and
# ./data/.models. Persist these across pod restarts to avoid re-downloading.
# ALCOVES_WHISPER_MODELS_DIR=./data/.whisper
# ALCOVES_MODELS_PATH=./data/.models

# Audio tagger — registry filename composed with this base URL.
ALCOVES_AUDIO_DETECT_MODEL_BASE_URL=https://s3.rustyguts.net/models
ALCOVES_AUDIO_DETECT_LABELS_URL=https://s3.rustyguts.net/models/audioset_class_labels_indices.csv

# Tuning knobs for the audio tagger output.
# ALCOVES_AUDIO_DETECT_WINDOW_SEC=10.0
# ALCOVES_AUDIO_DETECT_THRESHOLD=0.2
# ALCOVES_AUDIO_DETECT_TOP_K=5
