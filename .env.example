# Alcoves Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Server Mode
# =============================================================================

# Controls which capabilities this instance runs:
#   "all"    — API + background workers (default, recommended for local dev)
#   "api"    — API/web server only, no BullMQ workers
#   "worker" — BullMQ workers only (HTTP port stays open for health checks)
#
# For production, run separate containers with ALCOVES_MODE=api and ALCOVES_MODE=worker
ALCOVES_MODE=all

# Environment: "development" (default) or "production"
ALCOVES_ENV=development

# =============================================================================
# Required for Production
# =============================================================================

# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
# Example: postgres://postgres:postgres@localhost:5455/alcoves
ALCOVES_DATABASE_URL=postgres://postgres:postgres@localhost:5455/alcoves

# Session encryption secret (min 32 characters)
# Generate a secure random string for production
# Example: openssl rand -base64 32
ALCOVES_SESSION_SECRET=alcoves-dev-secret-key-change-in-production!!

# =============================================================================
# Optional
# =============================================================================

# Storage backend driver: local (defaults to local)
ALCOVES_STORAGE_DRIVER=local

# -----------------------------------------------------------------------------
# Local filesystem storage settings
# -----------------------------------------------------------------------------

# Path for storing uploaded files and media
# Defaults to ./data in the project root
ALCOVES_STORAGE_PATH=./data

# Optional override for avatar image storage directory
# Defaults to {ALCOVES_STORAGE_PATH}/avatars
ALCOVES_AVATAR_STORAGE_PATH=

# Optional override for transformed-media cache directory
# Defaults to {ALCOVES_STORAGE_PATH}/.cache
ALCOVES_CACHE_STORAGE_PATH=

# =============================================================================
# Job Queue (Optional - required for face recognition and background processing)
# =============================================================================

# Redis/Dragonfly host for BullMQ job queue
ALCOVES_QUEUE_HOST=localhost

# Redis/Dragonfly port (default 6389 for Dragonfly via docker-compose)
ALCOVES_QUEUE_PORT=6389

# Redis/Dragonfly password (leave blank if none)
ALCOVES_QUEUE_PASSWORD=

# =============================================================================
# Face Recognition Tuning (Optional)
# =============================================================================

# Detection minimum confidence score for SCRFD output filtering
ALCOVES_FACE_DETECTION_MIN_SCORE=0.28

# Maximum cosine distance for a face match (lower is stricter)
ALCOVES_FACE_RECOGNITION_MAX_DISTANCE=0.42

# Faces required before creating a new person cluster (core-point behavior)
ALCOVES_FACE_RECOGNITION_MIN_FACES=3

# Number of nearest-neighbor candidates considered during assignment
ALCOVES_FACE_RECOGNITION_NEIGHBOR_LOOKUP=80

# =============================================================================
# OAuth (Optional - for Google authentication)
# =============================================================================

# Public base URL of your app (used for OAuth redirect URIs)
# Dev default: http://localhost:5173 (Vite dev server)
# Production:  https://yourdomain.com
ALCOVES_BASE_URL=http://localhost:5173

# Google OAuth Client ID
# Get from Google Cloud Console: https://console.cloud.google.com/
# Authorized redirect URI: {ALCOVES_BASE_URL}/api/auth/google/callback
# e.g. http://localhost:5173/api/auth/google/callback (dev)
#      https://yourdomain.com/api/auth/google/callback (prod)
# Note: The frontend automatically detects available SSO providers from the backend
ALCOVES_OAUTH_GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
ALCOVES_OAUTH_GOOGLE_CLIENT_SECRET=
