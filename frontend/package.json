{
  "name": "alcoves",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "bun run test:unit:coverage && bun run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:flow": "playwright test test/e2e/flows",
    "test:e2e:screenshots": "playwright test --grep @screenshot",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "coverage:summary": "node test/scripts/coverage-summary.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@iconify/vue": "^5.0.1",
    "@nuxt/ui": "^4.8.1",
    "nuxt": "^4.4.7",
    "tailwindcss": "^4.3.0",
    "tus-js-client": "^4.3.1",
    "vidstack": "1.12.13",
    "vue": "^3.5.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.14.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
