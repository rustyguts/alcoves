{
  "name": "alcoves",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "nuxt typecheck",
    "test": "bun run test:unit:coverage && bun run test:e2e",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:face-ml": "bun run test/scripts/face-recognition-eval.ts",
    "coverage:summary": "node test/scripts/coverage-summary.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nuxt/ui": "^4.4.0",
    "bullmq": "^5.67.3",
    "drizzle-orm": "^0.45.1",
    "nuxt": "^4.3.1",
    "nuxt-auth-utils": "^0.5.28",
    "onnxruntime-node": "^1.24.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "vidstack": "^1.12.13",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.89",
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/vue": "^8.1.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "oxlint-tsgolint": "^0.11.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint && bun run fmt"
  }
}
